# Turn the engines field in package.json from a warning into a refusal.
#
# Without this, npm prints EBADENGINE and installs anyway — the run then fails
# later inside Vite with a message that says nothing about the Node version.
# Every dependency here declares an open-ended range (>=), none caps an upper
# bound, so nothing in the tree can trip this on a current runtime.
#
# Need past it once: npm install --engine-strict=false
engine-strict=true
